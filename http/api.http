@baseUrl = http://localhost:8080

@adminToken = {{loginAdmin.response.body.accessToken}}
@userToken = {{loginUser.response.body.accessToken}}
@todoId = {{createTodo.response.body.id}}
@userId = {{me.response.body.id}}

# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@todolist.com",
  "password": "Admin@12345"
}

### Cadastrar um USER
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Test",
  "email": "test1@gmail.com",
  "password": "Password123!"
}

### Login como USER
# @name loginUser
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test@gmail.com",
  "password": "Password123!"
}

### Dados do usuário logado
# @name me
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{userToken}}

### Pedir código de redefinição (sempre responde 202, mesmo para email inexistente)
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "test@gmail.com"
}

# Depois disso, "Login como USER" precisa usar a nova senha.
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "email": "test@gmail.com",
  "code": "123456",
  "newPassword": "NewPassword123!"
}

# Tarefas (como USER)

### Criar tarefa
# @name createTodo
POST {{baseUrl}}/api/todos
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Test todo",
  "description": "Test description",
  "dueDate": "2026-09-30"
}

### Listar tarefas (paginado, mais recentes primeiro)
GET {{baseUrl}}/api/todos?page=0&size=20&sort=createdAt,desc
Authorization: Bearer {{userToken}}

### Listar só as pendentes, ordenadas pelo prazo
GET {{baseUrl}}/api/todos?completed=false&sort=dueDate,asc
Authorization: Bearer {{userToken}}

### Buscar tarefa por id
GET {{baseUrl}}/api/todos/{{todoId}}
Authorization: Bearer {{userToken}}

### Atualizar tarefa (PUT substitui todos os campos)
PUT {{baseUrl}}/api/todos/{{todoId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Test todo updated",
  "description": "Test description",
  "completed": true,
  "dueDate": "2026-09-30"
}

### Remover tarefa
DELETE {{baseUrl}}/api/todos/{{todoId}}
Authorization: Bearer {{userToken}}

# Administração (como ADMIN)

### Listar todas as tarefas de todos os usuários
GET {{baseUrl}}/api/todos
Authorization: Bearer {{adminToken}}

### Listar usuários
GET {{baseUrl}}/api/admin/users?sort=email,asc
Authorization: Bearer {{adminToken}}

### Promover o USER a ADMIN (vale no próximo login dele)
PATCH {{baseUrl}}/api/admin/users/{{userId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "ADMIN"
}

### Remover o usuário (e todas as tarefas dele)
DELETE {{baseUrl}}/api/admin/users/{{userId}}
Authorization: Bearer {{adminToken}}



### 401: sem token
GET {{baseUrl}}/api/todos

### 401: token inválido
GET {{baseUrl}}/api/todos
Authorization: Bearer token-invalido

### 401: senha errada (mesma resposta de email inexistente)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test@gmail.com",
  "password": "aaaaaaaaa"
}

### 400: validação
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "",
  "email": "aaaaaaa",
  "password": "123"
}

### 400: ordenação por campo não permitido
GET {{baseUrl}}/api/todos?sort=owner.passwordHash
Authorization: Bearer {{userToken}}

### 403: USER acessando rota de ADMIN
GET {{baseUrl}}/api/admin/users
Authorization: Bearer {{userToken}}

### 404: tarefa inexistente
GET {{baseUrl}}/api/todos/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{userToken}}
